{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Questboard",
  "version": "0.2.0",
  "identifier": "com.questboard.desktop",
  "build": {
    "beforeDevCommand": "pnpm run desktop:dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run desktop:build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Questboard",
        "width": 1480,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../.desktop-build/tauri-sidecars/*": "sidecars/"
    },
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": null,
      "minimumSystemVersion": "12.0"
    }
  }
}
